# Copy this file to .env for local testing. In GitHub Actions these are
# set as repo secrets instead (Settings > Secrets and variables > Actions).

# Semrush API key (Account > API Keys in your Semrush dashboard)
SEMRUSH_API_KEY=

# monday.com API token (Avatar > Admin > API, or Profile > Developers)
# Needs write access to the Havwoods workspace boards.
MONDAY_API_TOKEN=

# Optional. Google PageSpeed Insights works without a key at low volume,
# but a free key removes the shared quota / rate limit. Get one at
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
