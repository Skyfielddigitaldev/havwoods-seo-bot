# Copy this file to .env for local testing. In GitHub Actions these are
# set as repo secrets instead (Settings > Secrets and variables > Actions).

# Semrush API key (Account > API Keys in your Semrush dashboard)
SEMRUSH_API_KEY=

# monday.com API token (Avatar > Admin > API, or Profile > Developers)
# Needs write access to the Havwoods workspace boards.
MONDAY_API_TOKEN=

# Otterly AI account API key, for the GEO/AI search tracking job
# (Otterly dashboard > Settings > API Keys).
OTTERLY_API_KEY=

# Optional, local testing only. The monthly Core Web Vitals job runs
# Lighthouse against a local headless Chrome; set this if chrome-launcher
# can't find Chrome on its own (GitHub Actions sets it automatically).
CHROME_PATH=
